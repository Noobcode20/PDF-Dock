{
  "name": "pdf-king-desktop",
  "version": "1.0.0",
  "private": true,
  "productName": "PDF King",
  "description": "A clean desktop PDF workspace.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5174 --strictPort\" \"wait-on http://127.0.0.1:5174 && node scripts/launch-electron.cjs\"",
    "build": "vite build"
  },
  "dependencies": {
    "docx": "^9.8.1",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pdfstudio": "^0.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "electron": "^38.1.2",
    "vite": "^7.1.7",
    "wait-on": "^8.0.4"
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "esbuild@0.28.2": true
  }
}
