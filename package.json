{
  "name": "pdf-dock-desktop",
  "version": "0.1.0-beta.5",
  "private": true,
  "productName": "PDF Dock",
  "description": "A clean desktop PDF workspace.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5174 --strictPort\" \"wait-on http://127.0.0.1:5174 && node scripts/launch-electron.cjs\"",
    "build": "vite build",
    "check": "npm run build",
    "package:mac": "npm run build && electron-builder --mac --x64 --arm64 --publish never",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "test": "node scripts/test-editor.mjs && node scripts/test-rich-text.mjs && node scripts/test-recent-files.mjs && node scripts/test-pdf-to-word.mjs && node scripts/test-pdf-compression.mjs && node scripts/test-page-numbers.mjs && node scripts/test-image-editing.mjs && node scripts/test-image-regressions.mjs && npm run test:repairs",
    "test:repairs": "node scripts/create-editor-fixtures.mjs && node scripts/create-sol-fixtures.mjs && node scripts/test-sol-repairs.mjs && node scripts/test-renderer-origin.cjs"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "docx": "^9.8.1",
    "docx-preview": "0.4.1",
    "electron-updater": "^6.8.9",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pdfstudio": "^0.4.0",
    "pptx-browser": "^4.1.5",
    "pptxgenjs": "^4.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "regenerator-runtime": "^0.14.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "vite": "^7.1.7",
    "wait-on": "^8.0.4"
  },
  "build": {
    "publish": [
      {
        "provider": "github",
        "owner": "Noobcode20",
        "repo": "PDF-Dock",
        "channel": "beta",
        "releaseType": "prerelease"
      }
    ],
    "appId": "com.pdfdock.app",
    "productName": "PDF Dock",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/pdf-dock.png",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "identity": "-",
      "icon": "assets/pdf-dock.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "PDF-Dock-macOS-${arch}.${ext}"
    },
    "win": {
      "icon": "assets/pdf-dock.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PDF-Dock-Windows.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron@44.5.1": true,
    "electron-winstaller@5.4.0": true
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
